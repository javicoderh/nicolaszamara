{
  "name": "nicolas-zamara-front",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "dev:api": "node scripts/dev.mjs --api-only",
    "build": "vite build && node scripts/generate_seo.mjs && vite build --ssr src/entry-server.jsx --outDir .preview/marketing-ssr && node scripts/prerender.mjs && node scripts/prepare_blog_runtime.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "jsdom": "27.1.0",
    "vite": "8.0.3",
    "vitest": "5.0.5"
  }
}
