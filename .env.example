# Configure this on the server only; never prefix it with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional server-only controls for isolated model tests. Defaults remain 512 tokens / 15 s.
# OPENAI_REASONING_EFFORT=low
# OPENAI_MAX_OUTPUT_TOKENS=25000
# OPENAI_REQUEST_TIMEOUT_SECONDS=25
# CHAT_TEST_METRICS=1
# Server only. Obtain the backend secret key from the project's Supabase settings.
# Never use VITE_ for these variables; the public forms keep their publishable key.
SUPABASE_URL=https://vsbolndzzkrhadprdlto.supabase.co
SUPABASE_SECRET_KEY=
# Generate a random secret of at least 32 characters. Keep it stable across instances.
CHAT_COOKIE_SECRET=
# Explicit USD/million-token ceiling rates for the exact configured text model.
# No price is guessed; update these when changing models or provider prices.
CHAT_INPUT_USD_PER_MILLION=
CHAT_OUTPUT_USD_PER_MILLION=
# Daily global budget in micro-USD (1 USD = 1000000 micro-USD). Choose before activation.
CHAT_DAILY_BUDGET_MICRO_USD=
# Local only. Vercel sets VERCEL automatically, which makes cookies Secure.
APP_ENV=development

# Public marketing settings. Disabled until the respective accounts are configured.
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_QA=false
VITE_GA4_MEASUREMENT_ID=
VITE_CLARITY_PROJECT_ID=
# Build only: indexation also requires VERCEL_ENV=production.
SEO_ALLOW_INDEXING=false
# Server only; keep false until the ledger migration is applied and verified.
MARKETING_LEDGER_ENABLED=false
# Server-only aggregate exports; independent from imports. No public report endpoint.
MARKETING_REPORTS_ENABLED=false

# Blog API generation is independent from the chatbot. Codex local needs none of these.
BLOG_GENERATION_ENABLED=false
BLOG_MODEL=gpt-6.1-sol
# Optional override; when empty, the blog uses OPENAI_API_KEY (chatbot key).
BLOG_OPENAI_API_KEY=
BLOG_WORKER_SECRET=
# Conservative reservation ceilings, NOT expected invoice amounts. Configure explicitly.
BLOG_JOB_BUDGET_MICRO_USD=0
BLOG_DAILY_BUDGET_MICRO_USD=0
# Public comments/likes sign a functional cookie using CHAT_COOKIE_SECRET
# (server-only SUPABASE_SECRET_KEY fallback). They never call a model API.
