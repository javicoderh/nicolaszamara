{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 45,
      "includeFiles": "config/**",
      "excludeFiles": "{node_modules/**,dist/**,src/**,tests/**,docs/**,database/**,*.docx,.vercel/**,.venv/**,.env*}"
    }
  },
  "rewrites": [
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
